# Sketch2Park Environment Configuration

# Application
APP_NAME=Sketch2Park
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Security
SECRET_KEY=sketch2park_super_secret_university_demo_key_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (commented out to allow config.py to resolve absolute path to project root sketch2park.db)
# DATABASE_URL=sqlite:///./sketch2park.db

# Storage Paths
UPLOAD_DIR=./uploads
SKETCHES_DIR=./uploads/sketches
CONDITIONING_DIR=./uploads/conditioning
RENDERS_DIR=./uploads/renders
SAMPLES_DIR=./uploads/samples

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png"]
MIN_IMAGE_DIMENSION=128
MAX_IMAGE_DIMENSION=4096
TARGET_IMAGE_SIZE=512

# AI Inference & Model Settings
DEVICE=auto
STABLE_DIFFUSION_MODEL_ID=runwayml/stable-diffusion-v1-5
CONTROLNET_MODEL_ID=lllyasviel/sd-controlnet-canny
ENABLE_CPU_FALLBACK=True
DEFAULT_NUM_INFERENCE_STEPS=25
DEFAULT_GUIDANCE_SCALE=7.5
DEFAULT_CONTROLNET_SCALE=0.8
